    {
      "id": "hud-ui",
      "type": "sso.edit",
      "target": "hudConfig",
      "edits": [
        {
          "action": "set",
          "path": [
            "partsTransferPopup"
          ],
          "before": {
            "state": "absent"
          },
          "value": {
            "json": {
              "__type": "PopupTransferPartsUiController"
            }
          }
        },
        {
          "action": "set",
          "path": [
            "wheelsTransferPopup"
          ],
          "before": {
            "state": "absent"
          },
          "value": {
            "json": {
              "__type": "PopupTransferWheelsUiController"
            }
          }
        },
        {
          "action": "append-unique",
          "path": [
            "popupIdForHideFunctionButton"
          ],
          "before": {
            "state": "present",
            "value": {
              "json": [
                "REPAIR",
                "REFUEL_STATION",
                "REFUEL"
              ]
            }
          },
          "value": {
            "json": "TRANSFER_PARTS"
          }
        },
        {
          "action": "append-unique",
          "path": [
            "popupIdForHideFunctionButton"
          ],
          "before": {
            "state": "present",
            "value": {
              "json": [
                "REPAIR",
                "REFUEL_STATION",
                "REFUEL"
              ]
            }
          },
          "value": {
            "json": "TRANSFER_WHEELS"
          }
        }
      ]
    },
